# Copy to `.env.local` and adjust. Validated at build time and startup by src/shared/config/env.schema.ts.
# Only VITE_* variables reach the browser bundle — NEVER put secrets in them.
# Empty values count as "not set" and fall back to the defaults.

VITE_APP_NAME="Erzurum Bilim Merkezi"
# development | staging | production
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:3000/api
# true → every route shows the "Çalışmalar devam ediyor" page (public pre-launch mode)
VITE_COMING_SOON=false
# Public site root encoded in printed QR codes (?q=KC-01). Keep the live address.
VITE_PUBLIC_SITE_URL=https://erzurum-bilim-merkezi.github.io/E-B-M-DIGITAL/

# Data backend: mock (in-browser demo data, default) | supabase. The live site runs on supabase.
VITE_BACKEND=mock
# Supabase project URL and PUBLISHABLE key (Project Settings → API Keys). Both are public by design;
# never put the secret (sb_secret_…) or service_role key here — the build refuses it.
# Development and tests never point at the live project: use the local stack (supabase start).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
